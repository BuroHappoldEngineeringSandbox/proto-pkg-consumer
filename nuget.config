<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="sandbox" value="https://nuget.pkg.github.com/BuroHappoldEngineeringSandbox/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="sandbox">
      <package pattern="Proto.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <sandbox>
      <add key="Username" value="proto" />
      <add key="ClearTextPassword" value="%PROTO_FEED_TOKEN%" />
    </sandbox>
  </packageSourceCredentials>
</configuration>
